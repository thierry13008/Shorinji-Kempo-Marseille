      class="fixed inset-0 z-[100] flex items-center justify-center px-6 py-12"
      style="display: none;"
    >
      <div 
        @click="activeModal = null"
        class="absolute inset-0 bg-surface/90 backdrop-blur-xl"
      ></div>
      
      <div 
        class="relative w-full max-w-5xl max-h-full overflow-y-auto bg-surface-low border border-white/10 rounded-[40px] shadow-2xl p-8 md:p-16 scrollbar-hide"
