                <div>
                  <h3 class="font-headline text-2xl mb-2">Les Kyu (級)</h3>
                  <p class="text-slate-400 font-light leading-relaxed">Le système de grades débute avec la ceinture blanche (6e kyu) et progresse vers la ceinture marron (1er kyu).</p>
                </div>
              </div>
              <div class="flex gap-6 items-start glass-card p-8 border-l-4 border-l-primary-gold">
                <div class="bg-primary-gold/20 w-16 h-16 rounded-lg flex items-center justify-center shrink-0 border border-primary-gold/20 text-xl">🏆</div>
                <div>
                  <h3 class="font-headline text-2xl mb-2 text-primary-gold">Les Dan (段)</h3>
                  <p class="text-slate-400 font-light leading-relaxed">Les ceintures noires vont du 1er au 9e Dan. Les trois premiers Dan représentent la maîtrise technique.</p>
                </div>
              </div>
            </div>
          </template>

          <template x-if="activeModal === 'deroulement'">
            <div class="space-y-6">
              {[
                { title: "Chinkon", sub: "Méditation", icon: "🧘", desc: "Méditation avec respiration Chôsoku pour se recentrer" },
                { title: "Taisô", sub: "Échauffement", icon: "⚡", desc: "Échauffement complet pour préparer le corps" },
                { title: "Kihon", sub: "Fondamentaux", icon: "👊", desc: "Travail de techniques de pieds et de poings" }
              ].map((step) => (
                <div class="glass-card p-8 border-l-4 border-l-primary-gold">
                  <div class="flex items-center gap-4">
                    <span class="text-2xl">{step.icon}</span>
                    <div>
                      <h4 class="text-lg font-bold text-white">{step.title} — {step.sub}</h4>
                      <p class="text-slate-400 text-sm">{step.desc}</p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </template>

          <template x-if="activeModal === 'organisation'">
            <div class="space-y-6">
              <div class="glass-card p-8 border-l-4 border-l-primary-gold">
                <h4 class="text-xl font-bold text-white mb-2">WSKO (World Shorinji Kempo Organization)</h4>
                <p class="text-slate-300">Organisation internationale présente dans plus de 30 pays assurant l'unité technique globale.</p>
              </div>
              <div class="glass-card p-8 border-l-4 border-l-primary-gold">
                <h4 class="text-xl font-bold text-white mb-2">France Shorinji Kempo</h4>
                <p class="text-slate-300">Régie nationale des clubs en France supervisant stages fédéraux et passages officiels.</p>
              </div>
            </div>
          </template>
        </div>

        <div class="mt-16 pt-8 border-t border-white/5 flex justify-center">
          <button 
            @click="activeModal = null"
            class="px-10 py-4 bg-primary-gold text-[#111111] font-bold rounded-2xl hover:bg-white hover:text-black transition-all uppercase tracking-widest text-xs"
          >
            Fermer l'archive
          </button>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
