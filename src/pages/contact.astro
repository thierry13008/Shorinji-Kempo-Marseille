---
import BaseLayout from '../layouts/BaseLayout.astro';

const contactInfo = {
  address: "38 Rue Raphaël Ponson, 13008 Marseille - Centre Social Saint-Giniez",
  phone: "06 89 09 05 44",
  email: "shorinjikempomarseille@gmail.com",
  hours: "Lundi: 20h00 - 21h30\nMercredi: 20h00 - 21h30\nVendredi: 20h15 - 21h45",
  discoveryOffer: [
    "1 cours d’essai gratuit",
    "Aucune obligation d'inscription",
    "Prêt du matériel pour l'essai",
    "Accompagnement personnalisé"
  ]
};

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://shorinji-kempo-marseille.vercel.app/" },
    { "@type": "ListItem", "position": 2, "name": "Contact", "item": "https://shorinji-kempo-marseille.vercel.app/contact" }
  ]
};
---
<BaseLayout 
  title="Contact Shorinji Kempo Marseille | Essai Gratuit Saint-Giniez" 
  description="Contactez le dojo Shorinji Kempo Marseille Saint-Giniez. Téléphone, adresse, horaires. Réservez votre cours d'essai gratuit au 06 89 09 05 44."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbData)} />

  {/* Fixed Background */}
  <div class="fixed inset-0 z-0 pointer-events-none">
    <img 
      class="w-full h-full object-cover opacity-80" 
      src="https://i.ibb.co/B5F7V0Bh/backgrount-agenda-WEBP.webp" 
      alt="Fond fixe contact"
      referrerpolicy="no-referrer"
      width={1920}
      height={1080}
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-surface/20 via-surface/40 to-surface"></div>
  </div>

  <main class="min-h-screen bg-transparent pt-32 pb-48 relative overflow-hidden" x-data="{ isMapOpen: false, mapZoom: 17 }">
    <div class="relative z-10 max-w-7xl mx-auto px-6">
      
      {/* Breadcrumb replacement */}
      <nav aria-label="Fil d'Ariane" class="mb-12 flex justify-center text-slate-400 text-sm gap-2 font-mono">
        <a href="/" class="hover:text-primary-gold transition-colors">Accueil</a>
        <span>/</span>
        <span class="text-white font-bold">Contact</span>
      </nav>

      <div class="text-center mb-16">
        <h1 class="text-white text-4xl md:text-6xl font-black mb-4">Prêt à commencer ?</h1>
        <p class="text-slate-300 text-lg">Réservez votre cours d’essai gratuit dès maintenant</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <div class="space-y-8">
          <div class="glass-card ki-aura-dark p-10 rounded-[24px] border border-white/10">
            <h2 class="text-white text-3xl font-bold mb-10">Informations de Contact</h2>
            <div class="space-y-8">
              <div class="flex items-start gap-6">
                <div class="w-12 h-12 rounded-xl bg-primary-gold/10 flex items-center justify-center shrink-0 border border-primary-gold/20 text-primary-gold">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                </div>
                <div>
                  <h3 class="text-white font-bold mb-1 text-lg">Adresse</h3>
                  <p class="text-slate-300 text-base">{contactInfo.address}</p>
                  <button 
                    @click="isMapOpen = true"
                    class="mt-2 text-primary-gold text-xs font-mono uppercase tracking-widest hover:underline"
                  >
                    Voir sur la carte
                  </button>
                </div>
              </div>
              <div class="flex items-start gap-6">
                <div class="w-12 h-12 rounded-xl bg-primary-gold/10 flex items-center justify-center shrink-0 border border-primary-gold/20 text-primary-gold">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                </div>
                <div>
                  <h3 class="text-white font-bold mb-1 text-lg">Téléphone</h3>
                  <a href={`tel:${contactInfo.phone.replace(/\s/g, '')}`} class="text-slate-300 text-base hover:text-primary-gold transition-colors">{contactInfo.phone}</a>
                </div>
              </div>
              <div class="flex items-start gap-6">
                <div class="w-12 h-12 rounded-xl bg-primary-gold/10 flex items-center justify-center shrink-0 border border-primary-gold/20 text-primary-gold">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
                </div>
                <div>
                  <h3 class="text-white font-bold mb-1 text-lg">Email</h3>
                  <a href={`mailto:${contactInfo.email}`} class="text-slate-300 text-base hover:text-primary-gold transition-colors">{contactInfo.email}</a>
                </div>
              </div>
              <div class="flex items-start gap-6">
                <div class="w-12 h-12 rounded-xl bg-primary-gold/10 flex items-center justify-center shrink-0 border border-primary-gold/20 text-primary-gold">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                </div>
                <div>
                  <h3 class="text-white font-bold mb-1 text-lg">Horaires d'accueil</h3>
                  <p class="text-slate-300 text-base whitespace-pre-line">{contactInfo.hours}</p>
                </div>
              </div>
            </div>
          </div>
          <div class="bg-surface glass-card border border-primary-gold/20 rounded-[24px] p-10 ki-aura-dark">
            <div class="flex items-center gap-4 mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="text-primary-gold w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg>
              <h3 class="text-white font-bold uppercase tracking-widest text-lg font-mono">Offre Découverte</h3>
            </div>
            <ul class="space-y-4 text-slate-300 text-lg">
              {contactInfo.discoveryOffer.map((item) => (
                <li class="flex items-center gap-2">✓ {item}</li>
              ))}
            </ul>
          </div>
          <div>
            <button 
              @click="isMapOpen = true"
              class="w-full bg-primary-gold/10 border border-primary-gold/20 px-6 py-4 rounded-xl inline-flex items-center justify-center gap-3 hover:bg-primary-gold/20 transition-all group font-mono text-sm"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="text-primary-gold group-hover:scale-110 transition-transform w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              <span class="font-bold tracking-wide uppercase text-white">Dojo Saint-Giniez</span>
            </button>
          </div>
        </div>

        <div class="space-y-8">
          <div class="glass-card ki-aura-dark p-10 rounded-[24px] border border-primary-gold/20">
            <h2 class="text-white text-3xl font-bold mb-2">Envoyez-nous un message</h2>
            <p class="text-slate-300 mb-8">Remplissez le formulaire ci-dessous</p>
            
            <div class="w-full overflow-hidden rounded-xl">
              <iframe 
                src="https://tally.so/embed/vG0JyA?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1" 
                loading="lazy" 
                width="100%" 
                height="423" 
                style="border:0;" 
                title="Nous contacter directement"
              ></iframe>
            </div>
          </div>

          <div class="glass-card ki-aura-dark p-10 rounded-[24px] border border-primary-gold/20 text-center">
            <p class="text-[#CCCCCC] flex items-center justify-center gap-4 mb-6">
              <span class="h-px bg-white/10 flex-1"></span>
              <span class="micro-copy uppercase tracking-widest text-white font-mono text-xs">ou contactez-nous directement</span>
              <span class="h-px bg-white/10 flex-1"></span>
            </p>
            <a 
              href={`tel:${contactInfo.phone.replace(/\s/g, '')}`} 
              class="w-full bg-white text-surface font-black py-4 rounded-xl flex items-center justify-center gap-3 hover:bg-slate-100 transition-all text-[16px] uppercase tracking-widest shadow-xl group font-mono text-black"
            >
              <div class="w-10 h-10 rounded-full bg-black/5 flex items-center justify-center group-hover:scale-110 transition-transform">
                <svg xmlns="http://www.w3.org/2000/svg" class="text-black w-[20px] h-[20px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              </div>
              {contactInfo.phone}
            </a>
          </div>
        </div>
      </div>
      
      <p class="text-xs text-slate-500 text-center mt-16 px-4 font-mono font-bold">
        En savoir plus : <a href="/encyclopedie" class="hover:text-primary-gold transition-colors">Encyclopédie du Shorinji Kempo</a> · <a href="/shorinji-kempo-marseille" class="hover:text-primary-gold transition-colors">Notre dojo à Marseille</a>
      </p>
    </div>

    {/* Maps Modal - Powered by Alpine.js */}
    <template x-if="isMapOpen">
      <div class="fixed inset-0 z-[100] flex items-center justify-center p-4 md:p-10">
        <div 
          @click="isMapOpen = false"
          class="absolute inset-0 bg-surface/80 backdrop-blur-sm transition-opacity"
        ></div>
        
        <div 
          class="relative w-full max-w-5xl h-[80vh] bg-surface rounded-[2.5rem] shadow-2xl overflow-hidden border border-white/10 glass-card ki-aura-dark p-2 transform scale-100 transition-all"
          @click.away="isMapOpen = false"
        >
          {/* Close Button */}
          <div class="absolute top-6 right-6 z-10">
            <button 
              @click="isMapOpen = false"
              class="w-12 h-12 rounded-full bg-bg-main flex items-center justify-center text-slate-800 hover:bg-slate-100 transition-all shadow-xl"
              aria-label="Fermer la carte"
            >
              ✕
            </button>
          </div>

          {/* Zoom Controls */}
          <div class="absolute bottom-24 right-6 z-10 flex flex-col gap-4">
            <div class="flex flex-col gap-2">
              <button 
                @click="mapZoom = Math.min(mapZoom + 1, 21)"
                class="w-12 h-12 rounded-full bg-bg-main flex items-center justify-center text-slate-800 hover:bg-slate-100 transition-all shadow-xl font-bold text-xl"
                title="Zoom avant"
              >
                +
              </button>
              <button 
                @click="mapZoom = Math.max(mapZoom - 1, 1)"
                class="w-12 h-12 rounded-full bg-bg-main flex items-center justify-center text-slate-800 hover:bg-slate-100 transition-all shadow-xl font-bold text-xl"
                title="Zoom arrière"
              >
                −
              </button>
            </div>
          </div>

          <iframe
            :src="`https://maps.google.com/maps?q=43.2719266,5.3916423&z=${mapZoom}&output=embed`"
            width="100%"
            height="100%"
            style="border: 0"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="rounded-[2rem]"
            title="Google Maps Dojo Saint-Giniez"
          ></iframe>
        </div>
      </div>
    </template>
  </main>
</BaseLayout>

<script is:inline>
  // Dynamic Tally embed loader script
  (function(d,g,y,s,e){
    if(d.getElementById(g))return;
    e=d.createElement(s);e.id=g;e.src=y;e.defer=true;
    d.body.appendChild(e);
  })(document,'tally-js','https://tally.so/widgets/embed.js','script');
</script>
