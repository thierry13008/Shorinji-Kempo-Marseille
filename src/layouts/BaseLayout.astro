---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ShareButton from '../components/layout/ShareButton.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  bodyClass?: string;
  showNavFooter?: boolean;
}
const { title, description, canonical, ogImage, bodyClass = "bg-surface text-on-surface", showNavFooter = true } = Astro.props;
const siteUrl = import.meta.env.SITE || 'https://shorinji-kempo-marseille.vercel.app';
---
<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical ?? siteUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical ?? siteUrl} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <link rel="icon" type="image/png" href="/favicon.png" />
  <title>{title}</title>

  {/* Fonts */}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Serif:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@500;600;700&family=JetBrains+Mono&display=swap" rel="stylesheet">
  
  <script>
    import Alpine from "alpinejs";
    (window as any).Alpine = Alpine;
    Alpine.start();
  </script>
  <ClientRouter />
</head>
<body class={`${bodyClass} font-body antialiased selection:bg-primary-gold/30 selection:text-white overflow-x-hidden`}>
  <a href="#main-content"
     class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[#FFD700] focus:text-[#111111] focus:rounded focus:ring-2">
    Aller au contenu principal
  </a>
  {showNavFooter && <Header />}
  <main id="main-content">
    <slot />
  </main>
  {showNavFooter && <Footer />}
  {showNavFooter && <ShareButton />}
</body>
</html>
