---
const NAV_LINKS = [
  { name: 'Accueil', path: '/' },
  { name: 'Encyclopédie', path: '/encyclopedie' },
  { name: 'Blog', path: '/blog' },
  { name: 'Contact', path: '/contact' },
];

const pathname = Astro.url.pathname;
const isCurrent = (path: string) => {
  if (path === '/') return pathname === '/';
  return pathname.startsWith(path);
};

const isLightPage = pathname === '/mentions-legales' || pathname === '/politique-confidentialite';
---
<header>
  <nav 
    x-data="{ isScrolled: false, open: false }"
    x-init="window.addEventListener('scroll', () => { isScrolled = window.scrollY > 20 }, { passive: true })"
    :class="(isScrolled || isLightPage || open) ? 'glass-nav shadow-2xl fixed top-0 z-50 w-full transition-all duration-500 h-20' : 'bg-transparent py-2 fixed top-0 z-50 w-full transition-all duration-500 h-20'"
    class="fixed top-0 z-50 w-full transition-all duration-500 h-20"
    aria-label="Navigation principale"
  >
    <div class="max-w-7xl mx-auto h-full px-4 md:px-8 flex items-center justify-between relative z-20">
      <a href="/" class="flex items-center gap-4 group shrink-0">
        <img 
          src="https://i.ibb.co/zT9kZ0D2/logo-shorinji-kempo-WEBP.webp" 
          alt="Logo Shorinji Kempo Marseille - Saint-Giniez" 
          :class="(isScrolled || isLightPage || open) ? 'h-10 lg:h-12 w-auto' : 'h-10 lg:h-16 w-auto lg:scale-110'"
          class="transition-all duration-500 object-contain group-hover:scale-110"
          referrerpolicy="no-referrer"
          fetchpriority="high"
          decoding="async"
          width="512"
          height="512"
        />
      </a>

      {/* Desktop Nav */}
      <div class="hidden lg:flex items-center gap-10">
        <div class="flex items-center gap-10">
          {NAV_LINKS.map((link) => (
            <a
              href={link.path}
              class={`relative font-label tracking-wide text-[19px] font-bold transition-all duration-300 group/link hover:scale-105 ${
                isCurrent(link.path) ? "text-primary-gold" : "text-ivory-silk hover:text-primary-gold"
              }`}
            >
              {link.name}
              <span class={`absolute -bottom-1 left-0 h-[3px] bg-primary-gold transition-all duration-300 rounded-full ${
                isCurrent(link.path) ? "w-full" : "w-0 group-hover/link:w-full"
              }`} />
            </a>
          ))}
        </div>
        
        <div class="flex items-center gap-6 ml-4">
          <div class="flex flex-col items-end">
            <a 
              href="/contact"
              class="cta-secondary"
            >
              Contactez-nous
            </a>
          </div>
        </div>
      </div>

      {/* Mobile Actions */}
      <div class="flex items-center gap-6 lg:hidden">
        <a 
          href="/contact"
          class="cta-secondary px-4 py-2 text-[12px]"
        >
          Contact
        </a>
        
        <button 
          x-on:click="open = !open"
          x-bind:aria-expanded="open.toString()"
          aria-controls="mobile-menu"
          class="text-white p-2 min-w-[48px] min-h-[48px] flex items-center justify-center cursor-pointer focus:ring-2 focus:ring-primary-gold/50 rounded-xl"
          aria-label="Ouvrir le menu de navigation"
        >
          <svg x-show="!open" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="menu-icon"><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg>
          <svg x-show="open" style="display: none;" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="close-icon"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
        </button>
      </div>
    </div>

    {/* Mobile Menu - Alpine + ARIA */}
    <div 
      id="mobile-menu"
      x-show="open"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 -translate-y-4"
      x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="opacity-100 translate-y-0"
      x-transition:leave-end="opacity-0 -translate-y-4"
      x-bind:aria-hidden="(!open).toString()"
      style="display: none;"
      class="absolute top-full left-0 w-full glass-nav border-t border-white/10 overflow-hidden lg:hidden"
    >
      <div class="flex flex-col p-8 gap-8">
        {NAV_LINKS.map((link) => (
          <a
            href={link.path}
            class={`font-label tracking-widest text-xl font-bold transition-all ${
              isCurrent(link.path) ? "text-primary-gold" : "text-ivory-silk"
            }`}
          >
            {link.name}
          </a>
        ))}
        <div class="h-[1px] bg-white/10 w-full my-2" />
        <div class="flex flex-col">
          <a 
            href="/contact"
            x-on:click="open = false"
            class="cta-secondary w-full flex items-center justify-center text-center"
          >
            Contactez-nous
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>

<script is:inline define:vars={{ isLightPage }}>
  // Ensure we can access path in client script if needed
  window.isLightPage = isLightPage;
</script>
