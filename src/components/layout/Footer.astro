---
const contactInfo = {
  address: "38 Rue Raphaël Ponson, 13008 Marseille - Centre Social Saint-Giniez",
  email: "shorinjikempomarseille@gmail.com",
  facebook: "https://www.facebook.com/shorinjikempo.marseille",
  hours: "Lundi: 20h00 - 21h30\nMercredi: 20h00 - 21h30\nVendredi: 20h15 - 21h45"
};
---
<footer class="bg-white/5 backdrop-blur-md text-[#CCCCCC] border-t border-white/10">
  <div class="max-w-7xl mx-auto px-6 py-[60px]">
    <div class="flex flex-col lg:flex-row gap-10 lg:gap-12 items-start">
      {/* Logo Section */}
      <div class="lg:w-[15%] flex-shrink-0 lg:-mt-8">
        <a href="http://www.shorinjikempomarseille.fr/" target="_blank" rel="noopener noreferrer" class="block">
          <img 
            src="https://i.ibb.co/zT9kZ0D2/logo-shorinji-kempo-WEBP.webp" 
            alt="Marseille Shorinji Kempo" 
            class="h-[120px] w-auto object-contain brightness-110"
            referrerpolicy="no-referrer"
            loading="lazy"
            width="120"
            height="120"
          />
        </a>
      </div>

      {/* Columns Grid */}
      <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[0.8fr_0.8fr_1fr_1.4fr] gap-8 items-start">
        {/* Colonne 1: Plan du site */}
        <div class="space-y-6">
          <h4 class="text-[#FFFFFF] font-sans font-bold text-[18px] uppercase tracking-wider border-b border-primary-gold/30 pb-2 inline-block">Navigation</h4>
          <nav aria-label="Footer Navigation">
            <ul class="text-[14px] md:text-[15px] space-y-2">
              <li><a href="/" class={`transition-colors font-normal py-1 block ${Astro.url.pathname === '/' ? 'text-[#FFC107]' : 'text-slate-300 hover:text-[#FFC107]'}`}>Accueil</a></li>
              <li><a href="/encyclopedie" class={`transition-colors font-normal py-1 block ${Astro.url.pathname.startsWith('/encyclopedie') ? 'text-[#FFC107]' : 'text-slate-300 hover:text-[#FFC107]'}`}>Encyclopédie</a></li>
              <li><a href="/blog" class={`transition-colors font-normal py-1 block ${Astro.url.pathname.startsWith('/blog') ? 'text-[#FFC107]' : 'text-slate-300 hover:text-[#FFC107]'}`}>Blog</a></li>
              <li><a href="/contact" class={`transition-colors font-normal py-1 block ${Astro.url.pathname.startsWith('/contact') ? 'text-[#FFC107]' : 'text-slate-300 hover:text-[#FFC107]'}`}>Contact</a></li>
              <li><a href="/mentions-legales" class={`transition-colors font-normal py-1 block ${Astro.url.pathname.startsWith('/mentions-legales') ? 'text-[#FFC107]' : 'text-slate-300 hover:text-[#FFC107]'}`}>Mentions Légales</a></li>
              <li><a href="/politique-confidentialite" class={`transition-colors font-normal py-1 block ${Astro.url.pathname.startsWith('/politique-confidentialite') ? 'text-[#FFC107]' : 'text-slate-300 hover:text-[#FFC107]'}`}>Politique de Confidentialité</a></li>
            </ul>
          </nav>
        </div>

        {/* Colonne 2: Liens Externes */}
        <div class="space-y-6">
          <h4 class="text-[#FFFFFF] font-sans font-bold text-[18px] uppercase tracking-wider border-b border-primary-gold/30 pb-2 inline-block">Liens</h4>
          <ul class="text-[14px] md:text-[15px] space-y-3">
            <li>
              <a href="https://shorinjikempo.fr/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 hover:text-[#FFC107] transition-colors text-slate-300 group">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-50 group-hover:opacity-100"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>
                Fédération Française
              </a>
            </li>
            <li>
              <a href="https://www.shorinjikempo.or.jp/wsko/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 hover:text-[#FFC107] transition-colors text-slate-300 group">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-50 group-hover:opacity-100"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>
                WSKO (World Organization)
              </a>
            </li>
            <li>
              <a href="http://www.shorinjikempomarseille.fr/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 hover:text-[#FFC107] transition-colors text-slate-300 group">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-50 group-hover:opacity-100"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>
                Site Officiel Marseille
              </a>
            </li>
            <li>
              <a href="https://www.facebook.com/Shorinjikempomarseille" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 hover:text-[#FFC107] transition-colors text-slate-300 group">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-50 group-hover:opacity-100"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>
                Facebook Club
              </a>
            </li>
            <li>
              <a href="https://shorinjikempomarseille.wordpress.com" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 hover:text-[#FFC107] transition-colors text-slate-300 group">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-50 group-hover:opacity-100"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>
                Blog WordPress
              </a>
            </li>
          </ul>
        </div>

        {/* Colonne 3: Contacts */}
        <div class="space-y-6">
          <h4 class="text-[#FFFFFF] font-sans font-bold text-[18px] uppercase tracking-wider border-b border-primary-gold/30 pb-2 inline-block">Contacts</h4>
          <div class="space-y-4 text-[14px] md:text-[15px]">
            <div class="flex items-start gap-3 group">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#FFC107] shrink-0 mt-1 group-hover:scale-110 transition-transform"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              <span class="leading-relaxed font-normal text-slate-300">{contactInfo.address}</span>
            </div>
            <div class="flex items-start gap-3 group">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#FFC107] shrink-0 mt-1 group-hover:scale-110 transition-transform"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              <span class="whitespace-pre-line leading-relaxed font-normal text-slate-300">{contactInfo.hours}</span>
            </div>
            <div class="flex items-start gap-3 group">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#FFC107] shrink-0 mt-1 group-hover:scale-110 transition-transform"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
              <a href={`mailto:${contactInfo.email}`} class="hover:text-[#FFC107] transition-colors flex items-center font-normal text-slate-300">{contactInfo.email}</a>
            </div>
          </div>
        </div>

        {/* Colonne 4: Réseaux sociaux & CTA */}
        <div class="space-y-8 flex flex-col bg-white/[0.03] p-6 rounded-3xl border border-white/5 backdrop-blur-sm">
          <div class="space-y-4">
            <h4 class="text-[#FFFFFF] font-sans font-bold text-[18px] uppercase tracking-wider border-b border-primary-gold/30 pb-2 inline-block">Suivez-nous</h4>
            <div class="flex gap-4">
              <a 
                href={contactInfo.facebook} 
                target="_blank" 
                rel="noopener noreferrer"
                class="w-12 h-12 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-[#CCCCCC] hover:text-[#FFC107] hover:border-[#FFC107]/50 transition-all duration-500 shadow-xl backdrop-blur-md group"
                aria-label="Facebook"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:scale-110 transition-transform"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
              </a>
            </div>
          </div>

          <div class="space-y-4 pt-2">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-primary-gold animate-pulse"></span>
              <p class="text-[11px] text-[#FFC107] font-black uppercase tracking-[0.2em] m-0">
                Séance gratuite offerte
              </p>
            </div>
            <a 
              href="/contact"
              class="bg-primary-gold hover:bg-white text-black font-black py-4 px-8 rounded-2xl transition-all duration-500 text-center text-sm uppercase tracking-widest shadow-[0_20px_40px_rgba(255,215,0,0.2)] hover:shadow-primary-gold/40 hover:-translate-y-1 active:scale-95 block"
            >
              Réserver mon essai
            </a>
          </div>
        </div>
      </div>
    </div>

    {/* Copyright */}
    <div class="mt-8 pt-6 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-[12px] text-[#999999] font-light text-center md:text-left m-0">
        © 2026 <a href="/shorinji-kempo-marseille" class="hover:underline">Shorinji Kempo Marseille</a>.
      </p>
      <p class="text-[12px] text-[#999999] font-light m-0 text-center md:text-right">
        Géré par <a href="https://www.kairyos-digital.fr/" target="_blank" rel="noopener noreferrer" class="text-primary-gold font-bold hover:underline">Kairyos Digital</a> au Prado (13008 Marseille).
      </p>
    </div>
  </div>
</footer>
