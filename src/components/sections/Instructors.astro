---
// Instructors list component
const instructors = [
  {
    name: "Sensei Olivier Beyer",
    role: "5ème Dan",
    image: "https://i.ibb.co/6pjTwv8/instructeur-1-BIS.png",
  },
  {
    name: "Assistante Yuko Irie Beyer",
    role: "3ème DAN",
    image: "https://i.ibb.co/N6C1DzjM/Yuko-IRIE-BEYER-webp.webp",
  },
  {
    name: "Assistante Marie Valentin",
    role: "3ème DAN",
    image: "https://i.ibb.co/cSs5RBFG/instructeur-4-BIS.png",
  },
  {
    name: "Assistant\nBenoit\nAllix",
    role: "1ERE DAN",
    image: "https://i.ibb.co/4RfgQzXV/instructeur-3-BIS.png",
    position: "center 20%"
  }
];
---
<section class="relative py-32 overflow-hidden bg-surface">
  {/* Background with parallax-like feel */}
  <div class="absolute inset-0 z-0">
    <img 
      class="w-full h-full object-cover opacity-80" 
      src="https://i.ibb.co/hxxzMwG9/fond-header-webp.webp" 
      alt="Fond décoratif Shorinji Kempo"
      referrerpolicy="no-referrer"
      loading="lazy"
      width={1920}
      height={1080}
    />
    <div class="absolute inset-0 bg-gradient-to-b from-surface/40 via-transparent to-surface/60"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6">
    <div class="text-center mb-20">
      <h2 class="text-white text-4xl md:text-6xl font-black mb-4">
        Nos Instructeurs de Shorinji Kempo
      </h2>
      <div class="h-1 w-24 bg-primary-gold mx-auto rounded-full"></div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8 max-w-7xl mx-auto">
      {instructors.map((instructor) => {
        return (
          <div class="relative group">
            {/* Glassmorphism Card with Ki Aura */}
            <div class="bg-[#1A243A]/40 backdrop-blur-[16px] ki-aura-dark p-8 h-full flex flex-col rounded-[40px] border border-white/5 shadow-2xl">
              {/* Image with Parallax Revelation (emerging from shadow) */}
              <div class="relative aspect-[4/5] w-4/5 mx-auto rounded-2xl overflow-hidden mb-8 bg-black/40 border border-white/10">
                <img 
                  src={instructor.image} 
                  alt={`Portrait de ${instructor.name.replace(/\n/g, ' ')} - Instructeur Shorinji Kempo`}
                  class="w-full h-full object-cover transition-all duration-700 hover:scale-105"
                  style={{ objectPosition: instructor.position || 'center' }}
                  referrerpolicy="no-referrer"
                  loading="lazy"
                  width={400}
                  height={500}
                />
                <div class="absolute inset-0 bg-gradient-to-t from-surface/80 via-transparent to-transparent opacity-60"></div>
              </div>

              {/* Kinetic Typography */}
              <div class="space-y-3 mt-auto text-center flex flex-col items-center">
                <h3 class="text-white font-bold text-xl leading-tight">
                  <span class="whitespace-pre-line text-balance">{instructor.name}</span>
                </h3>
                <div class="h-[1px] w-[40px] bg-primary-gold/50 mx-auto"></div>
                <p class="micro-copy font-mono font-bold uppercase tracking-wider text-xs text-[#FFC107]">
                  {instructor.role}
                </p>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <div class="mt-24 flex justify-center">
      <a 
        href="https://drive.google.com/file/d/1vnFGVh97khWmP9wlkZFw5kCni7uZTwxB/view?usp=drive_link"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-4 text-white hover:text-primary-gold transition-colors group font-mono text-xs"
      >
        <span class="h-[1px] w-12 bg-primary-gold/30 group-hover:w-20 transition-all"></span>
        <span class="uppercase tracking-widest font-bold">CALENDRIER DES ÉVÉNEMENTS</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" x2="12" y1="15" y2="3"></line></svg>
      </a>
    </div>
  </div>
</section>
