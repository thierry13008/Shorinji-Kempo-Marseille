---
// Hero section
---
<section class="relative min-h-screen flex items-center overflow-hidden">
  {/* Desktop Background Image */}
  <div class="absolute inset-0 z-0 overflow-hidden hidden lg:block">
    <img 
      class="w-full h-full object-cover opacity-80 animate-zoom-slow" 
      src="https://i.ibb.co/hxxzMwG9/fond-header-webp.webp" 
      alt="Dojo Shorinji Kempo Marseille - Pratique des arts martiaux"
      referrerpolicy="no-referrer"
      fetchpriority="high"
      width={1920}
      height={1080}
    />
    <div class="absolute inset-0 bg-gradient-to-b from-surface/40 via-transparent to-surface/60"></div>
  </div>
  
  <div 
    class="relative z-20 max-w-7xl mx-auto px-6 w-full pt-40 lg:pt-20"
    x-data="{ activeVideo: 1, isTransitioning: false }"
    @mouseenter="if (!isTransitioning) { isTransitioning = true; activeVideo = 2; const v2 = $refs.video2; if (v2) { v2.currentTime = 0; v2.play().catch(console.error); } }"
    @touchstart="if (!isTransitioning) { isTransitioning = true; activeVideo = 2; const v2 = $refs.video2; if (v2) { v2.currentTime = 0; v2.play().catch(console.error); } }"
    @click="if (!isTransitioning) { isTransitioning = true; activeVideo = 2; const v2 = $refs.video2; if (v2) { v2.currentTime = 0; v2.play().catch(console.error); } }"
  >
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="text-center lg:text-left relative z-50 pointer-events-none lg:pointer-events-auto">
        <span class="hidden lg:inline-flex micro-copy mb-6 items-center gap-2 px-4 py-1.5 border border-primary-gold/30 bg-primary-gold/10 rounded-full text-primary-gold font-bold">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path></svg>
          Plus qu'un sport, une voie de vie
        </span>
        <h1 class="text-white leading-[1.1] mb-8 text-5xl md:text-7xl font-extrabold tracking-tight lg:[text-shadow:none] [text-shadow:0_4px_15px_rgba(0,0,0,1)]">
          Révélez votre <span class="text-primary-gold italic">force intérieure</span> avec le Shorinji Kempo
        </h1>
        <p class="text-ivory-silk/90 lg:text-ivory-silk/80 max-w-xl mb-10 text-lg md:text-2xl font-medium leading-relaxed mx-auto lg:mx-0 lg:[text-shadow:none] [text-shadow:0_2px_10px_rgba(0,0,0,1)]">
          Rejoignez un dojo où le corps et l'esprit s'unissent. Apprenez à <span class="text-white border-b-2 border-primary-gold/50">vous protéger</span>, gagnez en sérénité et forgez un mental d'acier.
        </p>
        
        <div class="flex flex-col items-center lg:items-start gap-6 pointer-events-auto">
          <div class="flex flex-col sm:flex-row gap-6 w-full sm:w-auto">
            <a 
              href="/#contact"
              class="cta-button flex items-center justify-center gap-3 text-[16px] animate-float animate-pulse-gold group"
            >
              Réservez votre séance gratuite (places limitées)
              <svg xmlns="http://www.w3.org/2000/svg" class="w-[22px] h-[22px] group-hover:translate-x-2 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </a>
          </div>
          
          <div>
            <a 
              href="https://drive.google.com/file/d/1vnFGVh97khWmP9wlkZFw5kCni7uZTwxB/view?usp=drive_link"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 text-white/70 hover:text-primary-gold transition-colors group lg:[text-shadow:none] [text-shadow:0_2px_10px_rgba(0,0,0,1)]"
            >
              <span class="h-[1px] w-8 bg-primary-gold/30 group-hover:w-16 transition-all"></span>
              <span class="text-xs font-bold uppercase tracking-widest font-mono">CALENDRIER DES ÉVÉNEMENTS</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" x2="12" y1="15" y2="3"></line></svg>
            </a>
          </div>
          
          <p class="text-ivory-silk/80 lg:text-ivory-silk/60 text-sm font-bold uppercase tracking-[0.15em] lg:ml-2 lg:[text-shadow:none] [text-shadow:0_2px_8px_rgba(0,0,0,1)]">
            Séance d’essai gratuite – Sans engagement, accessible débutants
          </p>
        </div>
      </div>

      <div class="absolute inset-0 lg:relative lg:mt-0 z-0 lg:z-10 lg:opacity-100 overflow-hidden lg:overflow-visible">
        {/* Mobile Overlay */}
        <div class="absolute inset-0 bg-black/40 z-30 lg:hidden pointer-events-none"></div>

        <div class="w-full h-full lg:w-[450px] lg:aspect-[4/5] lg:rounded-[24px] lg:overflow-hidden lg:shadow-2xl lg:border lg:border-white/10 lg:transform lg:rotate-2 lg:glass-card lg:ki-aura-dark lg:p-2 cursor-pointer relative group/video-card bg-surface/5">
          {/* Vidéo 1: Normal */}
          <video 
            x-ref="video1"
            class="absolute inset-0 w-full h-full object-cover lg:rounded-xl transition-opacity duration-300"
            :class="activeVideo === 1 ? 'opacity-100 z-20' : 'opacity-0 z-10'"
            src="https://res.cloudinary.com/dpfewspme/video/upload/q_60,f_auto/v1774606161/video_salut_sans_watermark_gb80ku.mp4"
            poster="https://res.cloudinary.com/dpfewspme/video/upload/w_800,q_70,f_auto/v1774606161/video_salut_sans_watermark_gb80ku.jpg"
            autoplay="true"
            muted="true"
            playsinline="true"
            preload="metadata"
            @ended="isTransitioning = false"
          >
            <track kind="captions" />
          </video>
          
          {/* Vidéo 2: Inversée */}
          <video 
            x-ref="video2"
            class="absolute inset-0 w-full h-full object-cover lg:rounded-xl transition-opacity duration-300"
            :class="activeVideo === 2 ? 'opacity-100 z-20' : 'opacity-0 z-10'"
            src="https://res.cloudinary.com/dpfewspme/video/upload/e_reverse,q_60,f_auto/v1774606161/video_salut_sans_watermark_gb80ku.mp4"
            muted="true"
            playsinline="true"
            preload="metadata"
            @ended="activeVideo = 1; const v1 = $refs.video1; if (v1) { v1.currentTime = 0; v1.play().catch(console.error); }"
          >
            <track kind="captions" />
          </video>

          {/* Desktop Gradient Overlay */}
          <div class="absolute inset-0 bg-gradient-to-tr from-surface/80 via-transparent to-transparent pointer-events-none hidden lg:block z-20"></div>
          
          {/* Info Box */}
          <div class="hidden lg:block absolute bottom-6 left-6 right-6 p-6 bg-surface-low/60 backdrop-blur-md rounded-xl border border-white/10 pointer-events-none z-40">
            <p class="italic text-lg text-white font-headline">"Le Salut - Gassho Rei"</p>
            <p class="micro-copy mt-1 text-primary-gold uppercase tracking-widest font-mono text-xs">L'entrée dans la voie</p>
          </div>
        </div>
        
        {/* Desktop Glow */}
        <div class="hidden lg:block absolute -top-12 -right-12 w-48 h-48 bg-primary-gold/10 rounded-full blur-3xl"></div>
      </div>
    </div>
  </div>
</section>
